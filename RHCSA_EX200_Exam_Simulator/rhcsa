#!/bin/bash
# RHCSA EX200 Exam Simulator - the "rhcsa" command
#
# The simulator runs in the web browser. This command only reinstalls it with
# the latest version from GitHub, like the Update button in the web interface.
#
#   sudo rhcsa          reinstall / update
#   sudo rhcsa --help   show the installer options

INSTALLER_URL="https://raw.githubusercontent.com/RHCSA/RHCSA.github.io/main/Install_RHCSA_EX200_Exam_Simulator.sh"

if [[ $EUID -ne 0 ]]; then
    exec sudo bash "$0" "$@"
fi

tmp=$(mktemp /tmp/rhcsa_installer.XXXXXX) || exit 1
trap 'rm -f "$tmp"' EXIT

echo "Downloading the latest installer..."
if ! curl -fsSL --connect-timeout 15 "$INSTALLER_URL" -o "$tmp"; then
    echo "Could not download the installer. Check the internet connection and try again." >&2
    exit 1
fi

bash "$tmp" --force "$@"
